# ============================================================================
# Crypto Prediction - environment configuration (ALL VALUES ARE OPTIONAL)
#
# The app works out of the box with no .env file at all.
# Copy this to .env and fill in values only for features you want to enable:
#
#     cp .env.example .env
#
# ----------------------------------------------------------------------------

# --- Feature toggles --------------------------------------------------------
# Enable news/Reddit/FinBERT sentiment features (requires network access and
# the keys below; also: pip install -r requirements-optional.txt)
# CRYPTOPRED_USE_SENTIMENT=1

# --- Server -----------------------------------------------------------------
# CRYPTOPRED_API_PORT=8000
# STREAMLIT_PORT=8501

# --- Default symbol ----------------------------------------------------------
# DEFAULT_SYMBOL=BTC-USD

# --- Sentiment API keys (optional, used only if sentiment is enabled) --------
# CRYPTOPANIC_API_KEY=
# NEWSAPI_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_SECRET=
# TWITTER_BEARER_TOKEN=

# --- Trading (optional; never used for prediction) ---------------------------
# COINGECKO_API_KEY=
# BINANCE_API_KEY=
# BINANCE_SECRET=
# ALPACA_API_KEY=
# ALPACA_SECRET=
